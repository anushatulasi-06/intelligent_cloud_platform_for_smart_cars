# systemd unit for the FastAPI backend on EC2 (Amazon Linux 2023). Option A only.
# Installed by infra/aws/setup_ec2.sh as /etc/systemd/system/autosound-api.service.
#
#   sudo systemctl status autosound-api
#   journalctl -u autosound-api -f
#
# One uvicorn worker on purpose: backup jobs, the C3 processing worker and the C2 device sweeper
# run inside the API process, and interrupted jobs are marked failed at startup; all of this
# assumes a single process (see infra/aws/README.md).
# Settings come from backend/.env (read by app/config.py), so no EnvironmentFile is needed.
# No load balancer or proxy sits in front, so proxy headers are not trusted.

[Unit]
Description=Smart Car Platform API (C1-C5)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ec2-user
Group=ec2-user
WorkingDirectory=/home/ec2-user/autosound/backend
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ec2-user/autosound/backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 1
Restart=always
RestartSec=5
# Model load and Mongo index creation happen at startup; give them time before systemd gives up.
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
