# Production settings for the backend on EC2. setup_ec2.sh copies this to backend/.env
# the first time; fill in the <...> values there. Never commit the filled-in file.
DATABASE_URL=postgresql+psycopg2://<user>:<password>@<rds-endpoint>:5432/autosound
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/autosound
S3_BUCKET=<bucket>
AWS_REGION=us-west-2
MODEL_DIR=../model/artifacts
CONFIDENCE_THRESHOLD=0.75
CORS_ORIGINS=http://<frontend-bucket>.s3-website-us-west-2.amazonaws.com
SES_FROM_EMAIL=<verified-sender@example.com>
# Real side effects in production: SES email and pg_dump/mongodump backups to S3.
DEV_FAKE_EMAIL=false
DEV_FAKE_BACKUP=false
# LOCAL_AUDIO_DIR is deliberately absent: alert audio links are presigned S3 URLs.
# No AWS keys here: the instance's IAM role (iam-instance-policy.json) provides credentials.
