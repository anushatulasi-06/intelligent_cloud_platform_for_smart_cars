# Production settings for the backend on EC2. Used by both deployment options:
#   Option A (setup_ec2.sh) and Option B (docker/setup_ec2_docker.sh) copy this to backend/.env
#   the first time; fill in every <...> value there. The setup scripts refuse to continue while
#   any <...> placeholder is left. Never commit the filled-in file.
APP_ENV=production

# --- Data stores -----------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg2://<user>:<password>@<rds-endpoint>:5432/autosound
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/autosound
S3_BUCKET=<bucket>
AWS_REGION=us-west-2
# Blank = real AWS S3. Only set these for an S3-compatible service such as MinIO.
S3_ENDPOINT_URL=
S3_PUBLIC_ENDPOINT_URL=

# --- Secrets (generate new values; never reuse the development defaults) -------------------
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=<jwt-secret>
JWT_TTL_MINUTES=60
# python3 -c "import base64, secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Keep it forever: stored Wi-Fi passwords (F4) cannot be decrypted without the same key.
WIFI_ENCRYPTION_KEY=<wifi-encryption-key>

# --- Web ---------------------------------------------------------------------------------------
# Browser connects through a private SSH tunnel. Public HTTP origins are rejected.
# HTTPS production hosting requires a separate reviewed TLS/authentication design.
CORS_ORIGINS=http://127.0.0.1:5173

# --- Model -------------------------------------------------------------------------------------
MODEL_DIR=../model/artifacts
CONFIDENCE_THRESHOLD=0.75

# --- Real side effects in production -----------------------------------------------------------
SES_FROM_EMAIL=<verified-sender@example.com>
DEV_FAKE_EMAIL=false
DEV_FAKE_BACKUP=false

# --- Background work inside the API process (keep exactly one API process) --------------------
PROCESSING_WORKER_ENABLED=true
PROCESSING_WORKER_POLL_SECONDS=2
DEVICE_SWEEPER_ENABLED=true

# LOCAL_AUDIO_DIR is deliberately absent: alert audio links are presigned S3 URLs.
# No AWS keys here: the instance's IAM role (iam-instance-policy.json) provides credentials.
