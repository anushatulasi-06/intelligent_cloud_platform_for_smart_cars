# Optional demo feeds on the EC2 instance (both deployment options). Copy to infra/aws/edge.env
# (gitignored); the setup scripts do this the first time a demo feed is enabled.
#
# EDGE_*: the virtual car the local edge client drives (C2 Simulator F11, C3 uploads).
# These are the fresh development seed's devices; their keys are public in the repository.
# For anything beyond a class demo, register new devices in F4 and use their one-time keys.
EDGE_CAR_ID=1
EDGE_DEVICE_ID=1
EDGE_DEVICE_KEY=dev-device-key-mic-1
EDGE_CAMERA_DEVICE_ID=5
EDGE_CAMERA_DEVICE_KEY=dev-device-key-cam-1

# DEMO_DATA_ARGS: options for scripts/demo_data.py (C1 Map F9 / Tracking F10 positions).
# Keep the edge client's car (EDGE_CAR_ID) in --offline so two sources never write its route;
# list any other car there to show a grey offline marker.
DEMO_DATA_ARGS=--live --offline 1 4
