# Optional demo feeds on the EC2 instance (both deployment options). Copy to infra/aws/edge.env
# (gitignored); the setup scripts do this the first time a demo feed is enabled.
#
# EDGE_CLIENT: replay_client (default) replays bundled CARLA footage without a GPU/server.
# demo_client uses an illustrated virtual car with independently controlled Start/Stop route.
# Both use actual API/storage/processing; replay is recorded footage, not a live CARLA world.
EDGE_CLIENT=replay_client

# EDGE_*: the car and devices used by the selected edge client (F11 and C3 uploads).
# Use the private bootstrap credential file or register devices in F4. Never reuse repository
# development device keys. The installer stops if ENABLE_EDGE_DEMO=1 and these remain unfilled.
EDGE_CAR_ID=1
EDGE_DEVICE_ID=1
EDGE_DEVICE_KEY=<private-microphone-device-key>
EDGE_CAMERA_DEVICE_ID=5
EDGE_CAMERA_DEVICE_KEY=<private-camera-device-key>

# DEMO_DATA_ARGS: options for scripts/demo_data.py (C1 Map F9 / Tracking F10 positions).
# Keep the edge client's car (EDGE_CAR_ID) in --offline so two sources never write its route;
# list any other car there to show a grey offline marker.
DEMO_DATA_ARGS=--demo-only --live --offline 1 4
