# Optional: an edge client for car 1 as a background service, so the C2 Simulator (F11) is live
# and its sound scenarios run through C3/C4. Option A only. Installed by
# `ENABLE_EDGE_DEMO=1 bash infra/aws/setup_ec2.sh`. EDGE_CLIENT in infra/aws/edge.env picks the
# client: replay_client (recorded CARLA scenarios, the default) or demo_client (virtual car).
#
#   sudo systemctl stop autosound-edge      # before a CARLA client connects with the same devices
#   sudo systemctl start autosound-edge
#   journalctl -u autosound-edge -f

[Unit]
Description=Smart Car Platform edge client (CARLA replay or local demo)
After=autosound-api.service
Wants=autosound-api.service

[Service]
Type=simple
User=ec2-user
Group=ec2-user
WorkingDirectory=/home/ec2-user/autosound/backend
Environment=PYTHONUNBUFFERED=1
Environment=EDGE_API_URL=http://127.0.0.1:8000
EnvironmentFile=/home/ec2-user/autosound/infra/aws/edge.env
# No speakers on a server: the browser plays the scenario sound instead. In systemd, $$ is a literal $.
ExecStart=/bin/sh -c 'exec /home/ec2-user/autosound/backend/.venv/bin/python -m "edge.$${EDGE_CLIENT:-replay_client}" --no-audio-playback --buffer-dir .local_edge/demo'
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
