{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AudioBackupsArchivesObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": "arn:aws:s3:::<bucket>/*"
    },
    {
      "Sid": "AudioBackupsArchivesList",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::<bucket>"
    },
    {
      "Sid": "AlertEmails",
      "Effect": "Allow",
      "Action": ["ses:SendEmail"],
      "Resource": "*"
    }
  ]
}
