# Generated local-only demo environment. Do not commit infra/.env.demo.
# Run python3 infra/init_demo_env.py from the repository root.
# Blank credentials are generated once; existing values are preserved.
POSTGRES_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
JWT_SECRET=
WIFI_ENCRYPTION_KEY=

# Must be reachable by the browser, not just by containers. Keep the host/port
# identical to the published MinIO URL; altering signed URLs breaks signatures.
S3_PUBLIC_ENDPOINT_URL=http://127.0.0.1:9000
S3_BUCKET=autosound-audio-demo
AWS_REGION=us-west-2

# Fresh development seed devices only. Replace if demonstrating newly added ones.
EDGE_CAR_ID=1
EDGE_DEVICE_ID=1
EDGE_DEVICE_KEY=dev-device-key-mic-1
EDGE_CAMERA_DEVICE_ID=5
EDGE_CAMERA_DEVICE_KEY=dev-device-key-cam-1
