# Copy to backend/.env and adjust. Never commit .env.
DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/autosound
MONGO_URI=mongodb://localhost:27017/autosound
S3_BUCKET=autosound-audio-dev
AWS_REGION=us-west-2
S3_ENDPOINT_URL=
S3_PUBLIC_ENDPOINT_URL=
MODEL_DIR=../model/artifacts
CONFIDENCE_THRESHOLD=0.75
CORS_ORIGINS=http://localhost:5173
# Signing key for login tokens. Generate a new one for EC2: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-secret-change-me-before-deploying
JWT_TTL_MINUTES=60
DEV_FAKE_EMAIL=true
DEV_FAKE_BACKUP=true
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required for password-protected Wi-Fi. Keep private and reuse it after restarts.
WIFI_ENCRYPTION_KEY=
DEVICE_SWEEPER_ENABLED=true
PROCESSING_WORKER_ENABLED=true
PROCESSING_WORKER_POLL_SECONDS=2
# Blank disables the legacy local-audio override, so newly uploaded alert clips play from S3.
# Set .local_audio only when demonstrating old seeded alerts after scripts/make_local_audio.py
# has populated their files. Keep blank for the C2/C3 pipeline and deployed object storage.
LOCAL_AUDIO_DIR=
